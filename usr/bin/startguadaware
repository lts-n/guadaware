#!/bin/sh
set -e

# startguadaware — GuadaWare desktop launcher.
# Starts the system API, the GUI web server and the kiosk Wayland session.

# Resolve the runtime library directory. Prefer a system install; when run
# straight from this repository, fall back to the local usr/ tree.
LIBDIR=/usr/lib/libguadaware
if [ ! -d "$LIBDIR" ]; then
    SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd)"
    LIBDIR="$(cd -- "$SCRIPT_DIR/../lib" && pwd)/libguadaware"
fi

for tool in python3 cage chromium; do
    command -v "$tool" >/dev/null 2>&1 || {
        echo "error: required command '$tool' not found" >&2
        exit 1
    }
done

if ! python3 -c "import bottle" >/dev/null 2>&1; then
    echo "error: required Python module 'bottle' not found" >&2
    exit 1
fi

[ -d "$LIBDIR" ] || {
    echo "error: library directory not found: $LIBDIR" >&2
    exit 1
}

API_PORT=8080
BATTERY_API_PORT=8081
NOTES_PORT=8082
WEB_PORT=8000

if command -v ss >/dev/null 2>&1; then
    _port_in_use() { ss -tlnp 2>/dev/null | grep -q ":$1 "; }
elif command -v lsof >/dev/null 2>&1; then
    _port_in_use() { lsof -i :"$1" -sTCP:LISTEN >/dev/null 2>&1; }
else
    _port_in_use() { false; }
fi

if _port_in_use "$API_PORT"; then
    echo "error: port $API_PORT is already in use" >&2
    exit 1
fi
if _port_in_use "$BATTERY_API_PORT"; then
    echo "error: port $BATTERY_API_PORT is already in use" >&2
    exit 1
fi
if _port_in_use "$NOTES_PORT"; then
    echo "error: port $NOTES_PORT is already in use" >&2
    exit 1
fi
if _port_in_use "$WEB_PORT"; then
    echo "error: port $WEB_PORT is already in use" >&2
    exit 1
fi

# Trap must be installed BEFORE spawning any background process.
cleanup() {
    kill "$API_PID" "$BATTERY_API_PID" "$NOTES_PID" "$WEB_PID" 2>/dev/null || true
    wait "$API_PID" "$BATTERY_API_PID" "$NOTES_PID" "$WEB_PID" 2>/dev/null || true
}
trap cleanup EXIT INT TERM HUP

# 1. GuadaWare System API (Bottle) on localhost:8080.
nohup sh -c 'cd "$1" && exec python3 "$1/guadawareSystemAPI.py"' _ "$LIBDIR" >/dev/null 2>&1 &
API_PID=$!

# 2. GuadaWare System Battery API (Bottle) on localhost:8081.
nohup sh -c 'cd "$1" && exec python3 "$1/guadawareSystemBatteryAPI.py"' _ "$LIBDIR" >/dev/null 2>&1 &
BATTERY_API_PID=$!

# 3. GuadaWare Notes API (Bottle) on localhost:8082.
nohup sh -c 'cd "$1/guadawareGUI/apps/notes" && exec python3 app.py' _ "$LIBDIR" >/dev/null 2>&1 &
NOTES_PID=$!

# 4. Static GUI web server on localhost:8000.
nohup sh -c 'cd "$1/guadawareGUI" && exec python3 -m http.server 8000 --bind 127.0.0.1' _ "$LIBDIR" >/dev/null 2>&1 &
WEB_PID=$!

# Give background processes a moment to start and verify they are alive.
sleep 1
if ! kill -0 "$API_PID" 2>/dev/null; then
    echo "error: System API (port $API_PORT) failed to start" >&2
    exit 1
fi
if ! kill -0 "$BATTERY_API_PID" 2>/dev/null; then
    echo "error: System Battery API (port $BATTERY_API_PORT) failed to start" >&2
    exit 1
fi
if ! kill -0 "$NOTES_PID" 2>/dev/null; then
    echo "error: Notes API (port $NOTES_PORT) failed to start" >&2
    exit 1
fi
if ! kill -0 "$WEB_PID" 2>/dev/null; then
    echo "error: GUI server (port $WEB_PORT) failed to start" >&2
    exit 1
fi

# 5. Desktop session (Cage + Chromium kiosk). Block until the session ends.
"$LIBDIR/clientstart" || true
